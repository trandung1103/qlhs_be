DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_management?schema=public" # replace with your local credentials
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/student_management?schema=public" # non-pooled connection, used by `prisma migrate`; on Neon use the direct (non "-pooler") connection string
PORT=3000
FRONTEND_URL=http://localhost:5173 # FE origin allowed by CORS

# Auto backup to Google Drive — POST /api/backup/run (call it every few
# minutes via an external cron, e.g. cron-job.org; it no-ops if data is unchanged)
BACKUP_SECRET=                # shared secret, sent as the x-backup-secret header
GOOGLE_CLIENT_ID=             # OAuth client ID (Desktop app)
GOOGLE_CLIENT_SECRET=         # OAuth client secret
GOOGLE_REFRESH_TOKEN=         # obtained once via OAuth consent, see README
GOOGLE_DRIVE_FOLDER_ID=       # destination folder ID, from its Drive URL
